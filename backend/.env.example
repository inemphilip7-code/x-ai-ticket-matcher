# Autonomous Scanner Configuration
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_SECONDS=1500
AUTO_POST_CONFIDENCE_THRESHOLD=70

# Default Target Seller (Promoted in comments)
DEFAULT_SELLER_USERNAME=

# X (Twitter) Developer API Credentials
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-flash

# Server & Cloud Deployment Configuration (Render & Vercel)
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# When deployed on Render, set these:
# BACKEND_URL=https://your-bot-backend.onrender.com
# FRONTEND_URL=https://your-bot-frontend.vercel.app
BACKEND_URL=
FRONTEND_URL=
